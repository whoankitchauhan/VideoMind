# =========================================================================
# Environment Variables Example Template
# Duplicate this file as '.env' and fill in your actual credentials.
# =========================================================================

# --- API Keys & External Services ---
# Your Mistral AI API key (from console.mistral.ai)
MISTRAL_API_KEY=your_mistral_api_key_here

# --- AI & Transcription Model Configurations ---
# Options: tiny, base, small, medium, large
WHISPER_MODEL=base
